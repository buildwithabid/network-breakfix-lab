# Pinned versions for scripts/bootstrap.sh. Checked 2026-09-28.
# Changing a value here and re-running bootstrap is the only supported way to upgrade.

# Docker CE (download.docker.com, Debian 13 "trixie")
DOCKER_CE_VERSION="5:29.8.1-1~debian.13~trixie"
CONTAINERD_VERSION="2.3.6-1~debian.13~trixie"
BUILDX_VERSION="0.37.1-1~debian.13~trixie"
# Fingerprint of Docker's apt signing key (published at docs.docker.com/engine/install/debian)
DOCKER_GPG_FINGERPRINT="9DC858229FC7DD38854AE2D88D81803C0EBFCD88"

# containerlab (GitHub release .deb, verified by sha256 from the release's checksums.txt)
CONTAINERLAB_VERSION="0.79.0"
CONTAINERLAB_DEB_SHA256="a399d92a622b4664d8d1231bc9b7f53a1d210255a0306fa091c3f63779f65f13"

# Node.js 22 LTS (NodeSource). Only installed when node 22 is missing.
NODE_MAJOR="22"
NODE_DEB_VERSION="22.23.2-1nodesource1"

# Router image: official FRRouting image, pinned by multi-arch index digest
FRR_IMAGE_REF="quay.io/frrouting/frr:10.7.1"
FRR_IMAGE_DIGEST="sha256:e995beaa50fdc9edb35eadcfefa29b7f062cc06f2b812613789b68fa541554d2"

# Host image: built locally from infra/docker/breakfix-host (base pinned by digest inside)
HOST_IMAGE_REF="breakfix-host:0.1.0"

# gitleaks (developer tool, pre-push secret scan)
GITLEAKS_VERSION="8.30.1"
GITLEAKS_SHA256="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"

# ShellCheck linter (developer tool). Upstream publishes no checksum file; sha256 recorded
# from the v0.11.0 GitHub release asset on 2026-09-28.
SHELLCHECK_VERSION="0.11.0"
SHELLCHECK_SHA256="8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198"
