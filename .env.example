# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- server (apps/server) ---
HOST=127.0.0.1                 # interface to listen on
PORT=8480
DB_PATH=./data/breakfix.db     # SQLite database (created on first start)
SCENARIOS_DIR=./scenarios
WEB_DIST=./apps/web/dist       # built web app; served when present
PUBLIC_URL=http://localhost:8480   # printed in test links; WebSocket origin check
MAX_CONCURRENT_LABS=5          # labs running at once; further sessions queue
POLL_INTERVAL_MS=3000          # live diagram refresh per running lab
START_RATE_LIMIT=10            # test-link redemptions per IP per minute
COOKIE_SECURE=false            # true behind HTTPS
TRUST_PROXY=false              # true behind a reverse proxy (X-Forwarded-For)
LOG_LEVEL=info
# Optional whole-site HTTP basic auth (private review deployments). Password: 12+ characters.
# BASIC_AUTH_USER=review
# BASIC_AUTH_PASSWORD=change-me-to-something-long

# --- scripts/bootstrap.sh (read from the environment, not from .env) ---
# BFX_DEV_USER=            # account that gets wrapper + guard access; default: the user running sudo
# BFX_ALLOW_ANY_OS=0       # 1 skips the Debian 13 check (CI runners)
