{
  "name": "@breakfix/scenario-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Scenario schema, loader, lab runner and checker engine, shared by the server and the CLI.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bin": {
    "breakfix-scenario": "./dist/cli.js"
  },
  "dependencies": {
    "dockerode": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.1"
  }
}
